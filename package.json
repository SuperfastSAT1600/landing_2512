{
  "name": "sat-landing-page",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "BROWSER=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "fix": "npm run format && npm run lint:fix",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "audit": "npm audit",
    "deps:check": "depcheck",
    "deps:unused": "ts-prune",
    "analyze": "echo \"Add bundle analyzer command here\""
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.25",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.556.0",
    "next": "16.0.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.22",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^4.0.16",
    "prettier": "^3.2.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@playwright/test": "^1.41.0",
    "depcheck": "^1.4.7",
    "ts-prune": "^0.10.3",
    "license-checker": "^25.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
