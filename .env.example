# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin Auth
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Qwen (DashScope 국제) — CRM AI 요약 + Plaud 상담녹음 전사(STT) + 학생 임베딩 공용 키.
# QWEN_ANTHROPIC_BASE_URL: Anthropic 호환 엔드포인트(요약). 기본 https://dashscope-intl.aliyuncs.com/apps/anthropic
# QWEN_BASE_URL: OpenAI 호환 엔드포인트(임베딩). 기본 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_EMBEDDING_MODEL: 기본 text-embedding-v4 (1536차원 — students.embedding 컬럼과 일치해야 함).
#   ⚠️ 모델을 바꾸면 벡터 공간이 달라진다 → `npx tsx scripts/generate-embeddings.ts`로 전량 재임베딩 필수.
# QWEN_ASR_BASE_URL / QWEN_ASR_MODEL: 파일 전사(비동기 ASR). 기본값이 있어 보통 설정 불필요.
QWEN_API_KEY=
QWEN_ANTHROPIC_BASE_URL=
QWEN_BASE_URL=
QWEN_MODEL_STRONG=
QWEN_MODEL_FAST=
# QWEN_EMBEDDING_MODEL=text-embedding-v4
# QWEN_ASR_BASE_URL=https://dashscope-intl.aliyuncs.com
# QWEN_ASR_MODEL=fun-asr

# Plaud (CRM 상담 녹음 자동요약) — 서버가 원격 MCP(mcp.plaud.ai)로 녹음 목록·오디오 조회.
# `/plaud login`(Claude Code) 후 ~/.plaud/tokens-mcp.json의 refresh_token을 넣는다(부트스트랩 씨앗).
# 주의: 이 값은 access token(24h)이 아니라 refresh_token이며 7일 만료 + rotation 방식이다.
#   서버가 갱신할 때마다 새 refresh_token을 받아 Supabase(integration_tokens)에 저장해 체인을 유지하므로,
#   최초 1회만 넣으면 이후 자동 갱신된다. 7일 이상 무활동으로 만료되면 다시 넣어야 한다.
#   단기 테스트는 PLAUD_ACCESS_TOKEN로 대체 가능(갱신 생략).
# 다계정: 직원별 seed refresh_token을 각각 넣는다. PLAUD_REFRESH_TOKEN = 'me'(이민재) 계정,
#   PLAUD_REFRESH_TOKEN_WOOYOUNG = 'wooyoung'(김우영) 계정. 설정된 직원만 CRM 녹음 피커의 직원 선택에 노출된다.
PLAUD_REFRESH_TOKEN=
PLAUD_REFRESH_TOKEN_WOOYOUNG=

# Ghost CMS
GHOST_URL=
GHOST_ADMIN_KEY=

