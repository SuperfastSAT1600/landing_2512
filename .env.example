# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin Auth
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Plaud (CRM 상담 녹음 자동요약) — 서버가 원격 MCP(mcp.plaud.ai)로 녹음 목록·오디오 조회.
# `/plaud login`(Claude Code) 후 ~/.plaud/tokens-mcp.json의 refresh_token을 넣는다.
# refresh_token은 재사용 가능하며 서버가 access token을 자동 갱신한다(24h). 단기 테스트는 PLAUD_ACCESS_TOKEN로 대체 가능.
PLAUD_REFRESH_TOKEN=

# Ghost CMS
GHOST_URL=
GHOST_ADMIN_KEY=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_APPLICATION_WEBHOOK_URL=
SLACK_DIAGNOSIS_CHANNEL_ID=

# SMS Supabase (별도 프로젝트)
SUPERFASTSAT_V2_SUPABASE_URL=
SUPERFASTSAT_V2_SUPABASE_SERVICE_KEY=

# 기타
RESEND_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
SHEETS_SYNC_SECRET=
# Vercel Cron 인증 (diagnosis-expiry)
CRON_SECRET=

# 튜터링 학생 회원가입 브릿지 (결제완료 → 플랫폼 가입 링크)
# SUPERFASTSAT_PLATFORM_URL: 플랫폼(superfastsat) origin. 가입 링크 빌드용 — https://app.superfastsat.io
# SIGNUP_BRIDGE_SECRET: 플랫폼과 공유하는 시크릿. 플랫폼의 SIGNUP_BRIDGE_SECRET 과 반드시 동일해야 함.
SUPERFASTSAT_PLATFORM_URL=https://app.superfastsat.io
SIGNUP_BRIDGE_SECRET=
